# Required to sign in to the Hetzner URL dashboard.
VS_DASHBOARD_PASSWORD=replace-with-a-strong-password

# Recommended: use a stable, random value in production to preserve sessions
# across restarts.
VS_DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret

# Set only when initializing a brand-new users database. Keep the real value
# in the server's private .env file; never commit it.
VS_INITIAL_USER_PASSWORD=

# Optional email-based password recovery. Create a server-side .env from this
# example and fill in the SMTP values supplied by your email provider.
VS_PUBLIC_URL=https://vs.primexeu.com
VS_SMTP_HOST=
VS_SMTP_PORT=587
VS_SMTP_USER=
VS_SMTP_PASSWORD=
VS_SMTP_FROM=info@primexeu.com
VS_SMTP_STARTTLS=1
VS_SMTP_SSL=0
